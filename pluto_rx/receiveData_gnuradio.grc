options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: 'Visual OFDM monitor: Run opens the GNU Radio spectrum window (with a unified bandwidth slider that retunes the real sample rate) plus a top-down scrolling waterfall window drawn by the embedded python block.  No files written.'
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: receiveData_gnuradio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: Visual OFDM — ADALM-PLUTO Receiver
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 0
    - 0
    rotation: 0
    state: enabled
blocks:
- name: sample_rate
  id: parameter
  parameters:
    label: '''Initial sample rate (S/s)'''
    type: eng_float
    value: '500000'
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 12
    rotation: 0
    state: enabled
- name: fft_len
  id: parameter
  parameters:
    label: '''OFDM FFT length'''
    type: intx
    value: '512'
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 100
    rotation: 0
    state: enabled
- name: subcarriers
  id: variable
  parameters:
    value: fft_len-2
    comment: ''
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 188
    rotation: 0
    state: enabled
- name: driver
  id: parameter
  parameters:
    label: '''Soapy driver (plutosdr/hackrf)'''
    type: str
    value: '''plutosdr'''
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 276
    rotation: 0
    state: enabled
- name: pluto_uri
  id: parameter
  parameters:
    label: '''Soapy URI (empty = auto)'''
    type: str
    value: ''''''
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 364
    rotation: 0
    state: enabled
- name: agc
  id: parameter
  parameters:
