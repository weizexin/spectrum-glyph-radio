    rangeType: float
    start: 0.2e6
    step: 0.05e6
    stop: 4.0e6
    value: sample_rate
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 892
    rotation: 0
    state: enabled
