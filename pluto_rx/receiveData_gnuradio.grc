    width3: '1'
    color3: '"red"'
    alpha3: '1.0'
    label4: ''''''
    width4: '1'
    color4: '"red"'
    alpha4: '1.0'
    label5: ''''''
    width5: '1'
    color5: '"red"'
    alpha5: '1.0'
