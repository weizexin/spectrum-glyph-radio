    type: intx
    value: '0'
    short_id: ''
    hide: none
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 16
    - 452
    rotation: 0
    state: enabled
- name: max_rows
  id: parameter
  parameters:
