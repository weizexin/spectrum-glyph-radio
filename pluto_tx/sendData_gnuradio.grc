options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: Custom
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Visual OFDM Pluto transmitter; Run opens the compact dynamic-control
      UI.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: sendData_gnuradio
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u sendData_gnuradio_ui.py'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: "Visual OFDM \u2014 ADALM-PLUTO Transmitter"
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [608, 16.0]
    rotation: 0
    state: enabled

